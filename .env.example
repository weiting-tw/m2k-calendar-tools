# 複製這個檔為 .env，填入你的值（.env 請勿上傳/分享）
# 用法：把本檔另存為 .env 放在 m2kcal.py 同目錄

M2K_URL=https://mail.gss.com.tw/cgi-bin/cal/caldav/
M2K_USER=you@example.com
# 注意：SAML SSO，請用「應用程式/裝置專用密碼」，不是一般登入密碼
M2K_PASS=your-app-specific-password

# （選用）群組展開 CLI m2kgroup.py 需要的 session（從已登入瀏覽器複製，會過期）
# M2K_M=
# M2K_SSNID=
# M2K_COOKIE=
